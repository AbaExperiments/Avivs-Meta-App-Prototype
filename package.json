{
  "name": "avivs-meta-app-prototype",
  "version": "0.1.0",
  "description": "Spark Scope — real-time agent activity viewer for Muse Spark 1.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c violet,cyan \"vite\" \"tsx server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "simulate": "curl -X POST http://localhost:3001/api/simulate -H \"Content-Type: application/json\" | jq . || curl -X POST http://localhost:3001/api/simulate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
